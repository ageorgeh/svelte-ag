{
  "name": "svelte-ag",
  "version": "1.0.9",
  "description": "Useful svelte components",
  "bugs": "https://github.com/ageorgeh/svelte-ag/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ageorgeh/svelte-ag.git"
  },
  "author": "Alexander Hornung",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./sidebar": "./dist/components/sidebar/index.js",
    "./search": "./dist/components/search/index.js",
    "./form": "./dist/components/form/index.js",
    "./carousel": "./dist/components/carousel/index.js",
    "./vite": "./dist/vite/index.js",
    "./styles/*": "./dist/styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "./src/lib",
    "./dist"
  ],
  "scripts": {
    "prebuild": "svelte-kit sync",
    "build": "svelte-package",
    "postbuild": "tsx scripts/bundle-public-dts.ts && pnpm check:base-export",
    "check": "svelte-check --fail-on-warnings",
    "check:base-export": "tsx scripts/check-base-export.ts",
    "dev": "vite dev",
    "fmt": "prettier . --write",
    "fmt:check": "prettier . --check",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "husky",
    "svelte:sync": "svelte-kit sync",
    "test": "vitest --run",
    "test:e2e": "playwright test",
    "test:e2e-local": "PW_TEST_CONNECT_WS_ENDPOINT=ws://127.0.0.1:3005/ pnpm test:e2e",
    "watch": "svelte-package -w"
  },
  "dependencies": {
    "@dnd-kit-svelte/svelte": "^0.1.6",
    "@floating-ui/dom": "^1.7.6",
    "bits-ui": "^2.17.2",
    "clsx": "^2.1.1",
    "dequal": "^2.0.3",
    "devalue": "^5.7.0",
    "embla-carousel-svelte": "8.6.0",
    "formsnap": "2.0.1",
    "radash": "12.1.1",
    "runed": "0.37.1",
    "svelte-toolbelt": "^0.10.6",
    "sveltekit-superforms": "2.30.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "ts-ag": "^1.1.18",
    "tsc-alias": "^1.8.16",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@actions/languageserver": "^0.3.51",
    "@eslint/js": "^10.0.1",
    "@iconify/json": "^2.2.461",
    "@iconify/tailwind4": "^1.2.3",
    "@iconify/types": "^2.0.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.7.0",
    "@playwright/test": "1.58.2",
    "@rollup/plugin-typescript": "^12.3.0",
    "@sveltejs/kit": "^2.56.1",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@typescript/native-preview": "7.0.0-dev.20260410.1",
    "eslint": "^10.2.0",
    "eslint-plugin-better-tailwindcss": "^4.3.2",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-packagejson": "^3.0.1",
    "prettier-plugin-svelte": "^3.5.1",
    "rolldown": "1.0.0-rc.13",
    "rolldown-plugin-dts": "^0.23.2",
    "rollup-plugin-svelte": "^7.2.3",
    "semantic-release": "^25.0.3",
    "svelte": "^5.55.1",
    "svelte-check": "^4.4.6",
    "svelte-preprocess": "^6.0.3",
    "svelte2tsx": "^0.7.53",
    "tailwindcss": "4.2.2",
    "tsdown": "^0.21.7",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "type-fest": "^5.5.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "typescript-svelte-plugin": "^0.3.51",
    "vite": "^8.0.5",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "svelte-preprocess"
    ]
  }
}
