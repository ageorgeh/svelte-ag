{
  "name": "svelte-ag",
  "version": "1.0.9",
  "description": "Useful svelte components",
  "bugs": "https://github.com/ageorgeh/svelte-ag/issues",
  "author": "Alexander Hornung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ageorgeh/svelte-ag.git"
  },
  "bin": {
    "tailwind-manifest": "./dist/bin/build-tailwind-manifest/index.js"
  },
  "files": [
    "./src/lib",
    "./dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./sidebar": "./dist/components/sidebar/index.js",
    "./search": "./dist/components/search/index.js",
    "./form": "./dist/components/form/index.js",
    "./carousel": "./dist/components/carousel/index.js",
    "./vite": "./dist/vite/index.js",
    "./styles/*": "./dist/styles/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "svelte-kit sync",
    "build": "svelte-package",
    "postbuild": "tsx scripts/bundle-public-dts.ts && pnpm check:base-export && node dist/bin/build-tailwind-manifest/index.js",
    "check": "svelte-check --fail-on-warnings",
    "check:base-export": "tsx scripts/check-base-export.ts",
    "dev": "vite dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "husky",
    "svelte:sync": "svelte-kit sync",
    "tailwind:manifest": "tsx scripts/build-tailwind-manifest.ts",
    "tailwind:manifest:watch": "tsx scripts/build-tailwind-manifest.ts --watch",
    "test": "vitest --run",
    "test:e2e": "playwright test",
    "test:e2e-local": "PW_TEST_CONNECT_WS_ENDPOINT=ws://127.0.0.1:3005/ pnpm test:e2e",
    "watch": "svelte-package -w"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/svelte": "^0.5.0",
    "@floating-ui/dom": "^1.7.6",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "dequal": "^2.0.3",
    "devalue": "^5.8.1",
    "embla-carousel-svelte": "8.6.0",
    "es-module-lexer": "^2.2.0",
    "formsnap": "2.0.1",
    "oxc-parser": "^0.138.0",
    "radash": "12.1.1",
    "runed": "0.37.1",
    "svelte-toolbelt": "^0.10.6",
    "sveltekit-superforms": "2.30.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tsc-alias": "^1.8.17",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@actions/languageserver": "^0.3.58",
    "@eslint/js": "^10.0.1",
    "@iconify/json": "^2.2.493",
    "@iconify/tailwind4": "^1.2.3",
    "@iconify/types": "^2.0.0",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.22.0",
    "@playwright/test": "1.60.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@sveltejs/kit": "^2.68.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.13.2",
    "@typescript/native-preview": "7.0.0-dev.20260630.1",
    "eslint": "^10.6.0",
    "eslint-plugin-better-tailwindcss": "^4.6.0",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.57.0",
    "rolldown": "1.1.3",
    "rolldown-plugin-dts": "^0.26.0",
    "rollup-plugin-svelte": "^7.2.3",
    "semantic-release": "^25.0.5",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "svelte-preprocess": "^6.0.5",
    "svelte2tsx": "^0.7.57",
    "tailwindcss": "4.3.2",
    "ts-ag": "^1.3.0",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "typescript-svelte-plugin": "^0.3.52",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.1",
    "ts-ag": "^1.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "packageManager": "pnpm@11.9.0",
  "tailwindSources": "./dist/tailwind-sources.manifest.jsonc"
}
