{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 120,
  "semi": true,
  "proseWrap": "always",
  "svelte": {
    "sortOrder": "scripts-options-markup-styles"
  },
  "ignorePatterns": [
    "package-lock.json",
    "pnpm-lock.yaml",
    "node_modules/",
    ".gitignore",
    "dist/",
    "build/",
    ".out/",
    "*/.out/",
    ".svelte-kit/",
    ".husky/",
    "logs/",
    "*.log",
    "npm-debug.log*",
    "yarn-debug.log*",
    "yarn-error.log*",
    "pnpm-debug.log*",
    "*.png",
    ".d.ts",
    ".env",
    ".env.*.local",
    ".DS_Store",
    "Thumbs.db",
    "coverage/",
    "*/coverage/",
    "/shadcn",
    ".idea/",
    "*.bak",
    "*.swp",
    "*.swo",
    "*.swn",
    "*.orig",
    "*.rej",
    "*.md",
    "*.frag",
    "*.wgsl"
  ]
}
